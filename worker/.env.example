# Render worker configuration.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
WORKER_POLL_SECONDS=3
# Server-side ASR (enables filler + bad-take removal). Empty/uninstalled -> silence-only.
CADENCE_WHISPER_MODEL=base.en
CADENCE_WHISPER_DEVICE=cpu
CADENCE_WHISPER_COMPUTE=int8
# Premium "Cinematic motion" lane (Agency plan) — Wan 2.2 I2V-A14B on a Cloud Run JOB.
# Defaults target production; needs ADC with run.developer on the job + objectAdmin on
# the bucket (the worker's cadence-run@ SA has both). See gen/premium/PREMIUM_DEPLOY.md.
#CADENCE_PREMIUM_JOB=projects/builder-ai-497610/locations/us-central1/jobs/cadence-gen-premium
#CADENCE_PREMIUM_BUCKET=cadence-premium-jobs-uscentral1
#CADENCE_PREMIUM_POLL_S=3000
#CADENCE_PREMIUM_MAX_SCENES=24
